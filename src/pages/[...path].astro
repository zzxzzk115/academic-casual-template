---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Publications from '../components/Publications.astro';
import Timeline from '../components/Timeline.astro';
import {routes,projects,repositories,config,biography,href,dateLabel,type Route} from '../lib/content';
import {renderMarkdown} from '../lib/markdown';
export function getStaticPaths(){return routes.map(route=>({params:{path:route.path.slice(1,-1)},props:{route}}));}
const {route}=Astro.props as {route:Route};
const entry=route.entry;
---
<Layout title={route.title} description={route.description || config.site.description} image={entry?.image}>
  <div class="detail-container">
    <a class="back-link" href={href(entry?.kind==='project'?'/projects/':'/')} data-mode-preserve>← {entry?.kind==='project'?'All projects':'Back home'}</a>
    <header class="page-heading">{entry&&<p class="eyebrow">{entry.category}{entry.date?` · ${dateLabel(entry.date)}`:''}</p>}<h1>{route.title}</h1>{route.description&&<p>{route.description}</p>}{route.kind==='cv'&&config.identity.cv&&<a class="button button-primary" href={href(config.identity.cv)}>Download CV ↓</a>}</header>
    {route.kind==='projects'&&<ProjectGrid entries={projects} filters/>}
    {route.kind==='publications'&&<Publications/>}
    {route.kind==='cv'&&<><Timeline full/>{biography&&<section class="prose"><h2>Background & approach</h2><div set:html={renderMarkdown(biography)}/></section>}</>}
    {route.kind==='list'&&<div class="writing-list">{route.entries?.map(e=><article><time datetime={e.date}>{dateLabel(e.date)}</time><h2><a href={href(e.legacyPath)} data-mode-preserve>{e.title} ↗</a></h2><p>{e.description}</p></article>)}</div>}
    {route.kind==='repositories'&&<div class="repo-list">{repositories.map((repo,i)=><a href={`https://github.com/${repo}`}><span>{(i+1).toString().padStart(2,'0')}</span><strong>{repo}</strong><span>GitHub ↗</span></a>)}</div>}
    {entry&&<article class="prose" set:html={renderMarkdown(entry.body)}/>}
    {entry?.comments&&config.comments&&<section class="comments-section"><h2>Conversation</h2><div class="giscus" data-comments data-repo={config.comments.repo} data-repo-id={config.comments.repoId} data-category={config.comments.category} data-category-id={config.comments.categoryId}></div></section>}
  </div>
</Layout>
