---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '../styles/icons.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import FeatureBanner from '../components/FeatureBanner.astro';
import {config,repositories,href,sectionLabels,homeSections,type Mode} from '../lib/content';
interface Props {title?:string;description?:string;mode?:Mode;home?:boolean;image?:string;}
const {title,description=config.site.description,mode='academic',home=false,image}=Astro.props;
const canonical=new URL(Astro.url.pathname,config.site.url).toString();
const currentPath=Astro.url.pathname.slice(config.site.base.replace(/\/$/,'').length) || '/';
const academicTarget=home||currentPath.startsWith('/404')?href('/'):href(currentPath);
const casualTarget=home||currentPath.startsWith('/404')?href('/casual/'):href(currentPath,'casual');
const currentYear=new Date().getUTCFullYear();
const copyrightYears=config.site.copyrightStartYear&&config.site.copyrightStartYear<currentYear?`${config.site.copyrightStartYear}–${currentYear}`:String(currentYear);
---
<!doctype html>
<html lang={config.site.language}>
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
    <title>{title?`${title} — ${config.identity.name}`:config.site.title}</title>
    <meta name="description" content={description}/><link rel="canonical" href={canonical}/>
    <meta property="og:title" content={title || config.site.title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/>
    {image&&<meta property="og:image" content={new URL(href(image),config.site.url).toString()}/>}
    <meta name="twitter:card" content={image?'summary_large_image':'summary'}/><meta name="theme-color" content="#f8f7f3"/>
    <link rel="icon" href={config.site.favicon?href(config.site.favicon):`data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="18" fill="${config.theme.academic}"/><text x="32" y="42" font-family="sans-serif" font-size="29" text-anchor="middle" fill="white">${config.identity.initials.replace(/[^\w]/g,'')}</text></svg>`)}`}/>
    <link rel="alternate" type="application/rss+xml" title={config.site.title} href={href('/feed.xml')}/>
    <script is:inline>try{const t=localStorage.getItem('color-theme');document.documentElement.dataset.theme=t|| (matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.mode=new URLSearchParams(location.search).get('mode')==='casual'?'casual':location.pathname.includes('/casual/')?'casual':'academic';}catch{}</script>
    <style is:global define:vars={{academicAccent:config.theme.academic,casualAccent:config.theme.casual}}>:root{--academic:var(--academicAccent);--casual:var(--casualAccent);}</style>
  </head>
  <body class:list={{'home-with-sidebar':home&&config.modes[mode].sidebar}} data-mode={mode} data-base={config.site.base}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="site-navigation">
    <header class="site-header">
      <a class="brand" href={href(mode==='casual'?'/casual/':'/')}><span class="monogram">{config.identity.initials}<i></i></span><span class="brand-name">{config.identity.name}{config.identity.handle&&config.identity.handle!==config.identity.name&&<small>{config.identity.handle}</small>}</span></a>
      {(['academic','casual'] as const).map(navMode=><nav class="desktop-nav" aria-label="Main navigation" data-nav-mode={navMode} hidden={navMode!==mode}>{(config.modes[navMode].navigation??homeSections(navMode).filter(s=>['now','research','publications','projects','writing','contact'].includes(s))).filter(s=>homeSections(navMode).includes(s)).map(s=><a href={`${href(navMode==='casual'?'/casual/':'/')}#${s}`} data-section-link={s}>{sectionLabels[s]}</a>)}</nav>)}
      <div class="header-actions">
        <div class="mode-switch" aria-label="Presentation mode"><a href={academicTarget} data-mode-link="academic" aria-current={mode==='academic'?'page':undefined}>Academic</a><a href={casualTarget} data-mode-link="casual" aria-current={mode==='casual'?'page':undefined}>Casual</a></div>
        <button class="icon-button" aria-label="Search website" data-search hidden><Icon name="search"/></button>
        <button class="icon-button" aria-label="Switch color theme" data-theme-toggle hidden><Icon name="moon" class="theme-moon"/><Icon name="sun" class="theme-sun"/></button>
        <button class="icon-button menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-menu hidden><Icon name="list" class="menu-open"/><Icon name="x-lg" class="menu-close"/></button>
      </div>
    </header>
    <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" hidden>{(['academic','casual'] as const).map(navMode=><div data-nav-mode={navMode} hidden={navMode!==mode}>{(config.modes[navMode].navigation??homeSections(navMode)).filter(s=>homeSections(navMode).includes(s)).map(s=><a href={`${href(navMode==='casual'?'/casual/':'/')}#${s}`}>{sectionLabels[s]}</a>)}</div>)}</nav>
    </div>
    {home&&<FeatureBanner mode={mode}/>}
    <main id="main" data-pagefind-body><slot/></main>
    <footer class="site-footer"><span>{config.site.footerText||`© ${copyrightYears} ${config.identity.name}`}</span><div><a href={href('/feed.xml')}><Icon name="rss"/> RSS</a>{config.blog&&<a href={href(config.blog.href)}><Icon name="journal-text"/> Blog</a>}{repositories.length>0&&<a href={href('/repositories/')}><Icon name="github"/> Repositories</a>}</div></footer>
    <button type="button" class="icon-button back-to-top" aria-label="Back to top" title="Back to top" data-back-to-top hidden><Icon name="arrow-up"/></button>
    <dialog id="search-dialog" aria-label="Search website"><div class="search-heading"><strong>Find something</strong><button class="icon-button" data-search-close aria-label="Close search"><Icon name="x-lg"/></button></div><div id="search-results"></div><p class="muted">Search projects, research, and writing. <kbd>Esc</kbd> to close.</p></dialog>
    <div class="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/client';</script>
  </body>
</html>
