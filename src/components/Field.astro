---
import FocalField from './FocalField.vue';
import { config } from '../lib/content';
---
<div class="field" role="img" aria-label="An illustrative sampling field: denser detail near the focus, coarser detail in the periphery.">
  <div class="field-top"><span>Foveated sampling</span></div>
  <svg class="field-fallback" viewBox="0 0 600 480" aria-hidden="true">
    <defs><pattern id="grid" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="11" cy="11" r="1.3" fill="#507f9e" /></pattern><pattern id="fine" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4" cy="4" r="1" fill="#75dcc4" /></pattern><radialGradient id="glow"><stop stop-color="#25404e"/><stop offset="1" stop-color="#09111e"/></radialGradient></defs>
    <rect width="600" height="480" fill="url(#glow)"/><rect x="38" y="52" width="524" height="376" fill="url(#grid)"/>
    <circle cx="330" cy="240" r="88" fill="url(#fine)"/><circle cx="330" cy="240" r="90" fill="none" stroke="#6bc8b8" opacity=".6"/><circle cx="330" cy="240" r="168" fill="none" stroke="#507f9e" opacity=".5"/>
    <path d="M50 260 Q300 80 550 260M50 300 Q300 150 550 300" fill="none" stroke="#3d6b8b" opacity=".5"/>
  </svg>
  {config.hero.enabled && <FocalField intensity={config.hero.intensity} client:visible />}
  <p class="field-caption">{config.hero.label}</p>
</div>
