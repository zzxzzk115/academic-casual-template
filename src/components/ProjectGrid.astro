---
import { config, href, type Entry, type Mode } from '../lib/content';
import Icon from './Icon.astro';
interface Props { entries:Entry[]; mode?:Mode; filters?:boolean; }
const {entries,mode='academic',filters=false}=Astro.props;
const categories=[...new Set(entries.map(p=>p.category))];
const labels=config.projectCategories;
---
<div class="project-gallery" data-gallery>
  {filters && <div class="filters" role="group" aria-label="Filter projects"><button class="active" data-filter="all" aria-pressed="true">All {(config.sectionLabels.projects||'Projects').toLowerCase()} <span>{entries.length.toString().padStart(2,'0')}</span></button>{categories.map(c=><button id={c} data-filter={c} aria-pressed="false">{labels[c]||c} <span>{entries.filter(p=>p.category===c).length}</span></button>)}</div>}
  <div class="project-grid">
    {entries.map((p,i)=><article class:list={['project', { 'project-wide':i===0 && entries.length>2&&!!p.image,'project-text':!p.image }]} data-category={p.category}>
      {p.image&&<a class="project-image" href={href(p.legacyPath,mode)} aria-label={`Explore ${p.title}`}>
        <img src={href(p.image)} alt={p.imageAlt||p.title} loading="lazy" decoding="async" width="960" height="600" />
        <span class="project-arrow" aria-hidden="true" data-pagefind-ignore><Icon name="arrow-up-right"/></span>
      </a>}
      <div class="project-copy">
      <div class="project-meta">{p.tags.slice(0,2).join(' / ') || p.category}</div>
      <h3><a href={href(p.legacyPath,mode)}>{p.title}</a></h3><p>{p.description}</p>
      {p.status&&<p class="project-status">{p.status}</p>}{p.links.length>0&&<div class="project-links">{p.links.map(link=><a href={href(link.href)}>{link.icon&&<Icon name={link.icon}/>} {link.label}</a>)}</div>}
      </div>
    </article>)}
  </div>
  <p class="sr-only" aria-live="polite" data-filter-status></p>
</div>
