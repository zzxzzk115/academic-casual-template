---
import Icon from './Icon.astro';
import {config,href,type Mode} from '../lib/content';
interface Props {
  mode: Mode;
  email?: string;
  socials: typeof config.socials;
  class?: string;
}
const {mode,email,socials,class:className='hero-actions'}=Astro.props;
---
<div class={className}>
  {email&&<a href={`mailto:${email}`}><Icon name="envelope"/> <span>{email}</span></a>}
  {config.identity.cv&&mode==='academic'&&<a href={href(config.identity.cv)}><Icon name="download"/> <span>CV</span></a>}
  {socials.map(s=><a href={href(s.href)}><Icon name={s.icon||(s.label==='GitHub'?'github':s.label==='LinkedIn'?'linkedin':'link-45deg')}/> <span>{s.label}</span></a>)}
  {mode==='casual'&&config.blog&&<a href={href(config.blog.href)}><Icon name="journal-text"/> <span>Blog</span></a>}
</div>
