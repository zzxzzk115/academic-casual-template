---
import {cv} from '../lib/content';
const {full=false}=Astro.props;
const rows=[...cv.education,...cv.work].sort((a,b)=>b.start.localeCompare(a.start));
---
<div class="timeline">{(full?rows:rows.slice(0,4)).map(r=><article><div class="timeline-date">{r.start.slice(0,4)} — {r.end==='Present'?'Present':r.end.slice(0,4)}</div><div><h3>{r.title}</h3><p>{r.institution}</p>{full&&r.description&&<p class="muted">{r.description}</p>}</div></article>)}</div>
{full&&<div class="cv-extra"><div><h2>Languages</h2><p>{cv.languages.join(' · ')}</p></div><div><h2>Tools & technologies</h2><p>{cv.skills.join(' · ')}</p></div></div>}
