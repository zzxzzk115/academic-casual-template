---
import Layout from '../layouts/Layout.astro';
import Field from './Field.astro';
import ProjectGrid from './ProjectGrid.astro';
import Publications from './Publications.astro';
import Timeline from './Timeline.astro';
import {config,profile,projects,posts,news,href,dateLabel,loadBlog,sectionLabels,type Mode} from '../lib/content';
const {mode='academic'}=Astro.props as {mode:Mode};
const isCasual=mode==='casual';
const available=projects.filter(p=>p.modes.includes(mode));
const configured=config.modes[mode].featuredProjects.map(id=>projects.find(p=>p.id===id)!);
const selected=configured.length?configured:available.some(p=>p.featured)?available.filter(p=>p.featured):available;
const featured=selected[0];
const blog=await loadBlog();
const writing=[...posts.map(p=>({title:p.title,url:p.legacyPath,summary:p.description,date:p.date,source:'Note'})),...blog.map(p=>({title:p.title,url:p.url,summary:p.summary,date:p.date_published,source:'Blog'}))].sort((a,b)=>(b.date||'').localeCompare(a.date||'')).slice(0,4);
---
<Layout mode={mode} home>
  <section class:list={['hero',{'hero-casual':isCasual}]}>
    <div class="hero-copy">
      <h1>{isCasual?config.identity.handle:config.identity.name}</h1>
      <p class="hero-role">{isCasual?'Games, graphics, and handhelds.':config.identity.role}</p>
      {!isCasual&&<p class="hero-affiliation">{config.identity.institution} · {config.identity.location}</p>}
      <p class="hero-summary">{isCasual?profile.casualSummary:profile.summary}</p>
      {!isCasual&&profile.background&&<p class="hero-background">{profile.background}</p>}
      <div class="hero-actions"><a href={`mailto:${config.identity.email}`}>{config.identity.email}</a>{config.identity.cv&&!isCasual&&<a href={href(config.identity.cv)}>CV ↓</a>}{config.socials.filter(s=>['GitHub','LinkedIn'].includes(s.label)).map(s=><a href={href(s.href)}>{s.label} ↗</a>)}{isCasual&&<a href={href(config.blog.href)}>Blog ↗</a>}</div>
      {isCasual&&<p class="casual-aside">Also {config.identity.name}, a PhD researcher at {config.identity.institution}. <a href={href('/')} data-mode-fixed>Academic page ↗</a></p>}
    </div>
    {isCasual?<div class="casual-preview">{featured?.image?<a href={href(featured.legacyPath,mode)}><div class="preview-bar"><span class="window-dots"><i></i><i></i><i></i></span><span>{featured.title}</span><span>↗</span></div><img src={href(featured.image)} alt={`${featured.title} in action`} width="640" height="480" fetchpriority="high"/><p>{featured.tags.join(' · ')}</p></a>:<Field/>}</div>:<aside class="academic-aside">{config.identity.photo&&<img class="portrait" src={href(config.identity.photo)} width="180" height="210" alt={config.identity.name} fetchpriority="high"/>}<div class="small-field"><Field/></div></aside>}
  </section>
  {config.modes[mode].sections.map(section=> <section id={section} class:list={['home-section',`section-${section}`]}>
    <div class="section-heading"><h2>{section==='projects'?(isCasual?'Projects & games':'Selected projects'):section==='research'?'Research interests':section==='writing'?'Recent writing':section==='contact'?'Contact':sectionLabels[section]}</h2>{section==='projects'&&<a href={href('/projects/',mode)}>All projects ↗</a>}{section==='publications'&&<a href={href('/publications/')}>Bibliography ↗</a>}{section==='writing'&&<a href={href(config.blog.href)}>Blog ↗</a>}{section==='cv'&&<a href={href('/cv/')}>Full CV ↗</a>}</div>
    {section==='research'&&<div class="research-grid">{profile.research.map(r=><article><h3>{r.title}</h3><p>{r.description}</p></article>)}</div>}
    {section==='projects'&&<ProjectGrid entries={selected} mode={mode} filters={isCasual}/>}
    {section==='publications'&&<Publications/>}
    {section==='news'&&<div class="news-list">{news.slice(0,3).map(n=><article><time datetime={n.date}>{dateLabel(n.date)}</time><div><a href={href(n.legacyPath,mode)}>{n.title}</a><p>{n.description}</p></div></article>)}</div>}
    {section==='cv'&&<Timeline/>}
    {section==='writing'&&<div class="writing-list">{writing.map(w=><article><div class="writing-meta"><time datetime={w.date}>{dateLabel(w.date)}</time><span>{w.source}</span></div><h3><a href={href(w.url,mode)}>{w.title}</a></h3>{w.summary&&<p>{w.summary}</p>}</article>)}</div>}
    {section==='interests'&&<div class="interests-grid">{profile.interests.map(interest=><article><h3>{interest.title}</h3><p>{interest.description}</p>{interest.href&&<a href={href(interest.href)}>More ↗</a>}</article>)}</div>}
    {section==='about'&&<div class="about-block">{config.identity.photo&&<img src={href(config.identity.photo)} alt={config.identity.name} width="150" height="170" loading="lazy"/>}<div><p>{profile.summary}</p><p>{profile.background}</p><a href={href('/')} data-mode-fixed>Academic page ↗</a></div></div>}
    {section==='contact'&&<div class="contact-body"><a class="contact-email" href={`mailto:${config.identity.email}`}>{config.identity.email}</a>{config.identity.address&&<p>{config.identity.address}</p>}<div>{config.socials.map(s=><a href={href(s.href)}>{s.label} ↗</a>)}</div></div>}
  </section>)}
</Layout>
